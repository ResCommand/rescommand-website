generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────

enum Role {
  EMPLOYEE
  MANAGER
  OWNER
}

// ─── Platform: Multi-Tenancy ─────────────────────────────────

model Tenant {
  id              Int       @id @default(autoincrement())
  name            String
  slug            String    @unique                    // e.g. "duffersdonutshop"
  domain          String?   @unique                    // Custom domain e.g. "ops.duffersdonutshop.com"
  businessType    String    @default("DONUT_SHOP")     // DONUT_SHOP, BAKERY, CAFE, RESTAURANT, BAR, FOOD_TRUCK
  plan            String    @default("STARTER")        // FREE, STARTER, PROFESSIONAL, ENTERPRISE
  stripeCustomerId String?  @map("stripe_customer_id")
  active          Boolean   @default(true)
  logoUrl         String?   @map("logo_url")
  primaryColor    String?   @map("primary_color") @default("#1A56DB")
  settings        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  members         TenantUser[]
  subscription    TenantSubscription?
  employeeCategories    EmployeeCategory[]
  productCategories     ProductCategory[]
  products              Product[]
  productIngredients    ProductIngredient[]
  transactions          Transaction[]
  transactionLines      TransactionLine[]
  drinkLogs             DrinkLog[]
  donutLogs             DonutLog[]
  vendors               Vendor[]
  inventoryItems        InventoryItem[]
  inventoryOrders       InventoryOrder[]
  inventoryOrderLines   InventoryOrderLine[]
  inventoryCounts       InventoryCount[]
  inventoryCountLines   InventoryCountLine[]
  inventorySections     InventorySection[]
  orderRequests         OrderRequest[]
  holidaySchedules      HolidaySchedule[]
  weatherCache          WeatherCache[]
  parSheets             ParSheet[]
  parSheetLines         ParSheetLine[]
  predictionModels      PredictionModel[]
  overboardSchedules    OverboardSchedule[]
  overboardLines        OverboardLine[]
  cleaningTasks         CleaningTask[]
  cleaningLogs          CleaningLog[]
  maintenanceLogs       MaintenanceLog[]
  employeeHours         EmployeeHour[]
  sops                  Sop[]
  dashboardLayouts      DashboardLayout[]
  espressoDialLogs      EspressoDialLog[]
  recipeCategories      RecipeCategory[]
  recipes               Recipe[]
  productionTargetOverrides ProductionTargetOverride[]
  batchCompletions      BatchCompletion[]
  trayOverrides         TrayOverride[]
  prepItems             PrepItem[]
  notifications         Notification[]
  notificationReads     NotificationRead[]
  notificationRecipients NotificationRecipient[]
  shifts                Shift[]
  availabilityBlocks    AvailabilityBlock[]
  timeOffRequests       TimeOffRequest[]
  scheduleTemplates     ScheduleTemplate[]
  templateShifts        TemplateShift[]
  moduleConfigs         ModuleConfig[]
  greenCoffees          GreenCoffee[]
  roastProfiles         RoastProfile[]
  roastLogs             RoastLog[]
  menuTasks             MenuTask[]
  socialPosts           SocialPost[]

  @@map("tenants")
}

model TenantUser {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  userId      Int       @map("user_id")
  role        Role      @default(EMPLOYEE)
  invitedBy   Int?      @map("invited_by")
  acceptedAt  DateTime? @map("accepted_at")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  inviter     User?     @relation("TenantInviter", fields: [invitedBy], references: [id])

  @@unique([tenantId, userId])
  @@map("tenant_users")
}

model TenantSubscription {
  id                  Int      @id @default(autoincrement())
  tenantId            Int      @unique @map("tenant_id")
  stripeSubscriptionId String  @map("stripe_subscription_id")
  stripePriceId       String   @map("stripe_price_id")
  status              String   @default("active")    // active, past_due, canceled, trialing
  currentPeriodStart  DateTime @map("current_period_start")
  currentPeriodEnd    DateTime @map("current_period_end")
  cancelAtPeriodEnd   Boolean  @default(false) @map("cancel_at_period_end")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  @@map("tenant_subscriptions")
}

model EmployeeCategory {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("#6B7280")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  members   User[]

  @@map("employee_categories")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         Role      @default(EMPLOYEE)
  phone        String?
  active       Boolean   @default(true)
  categoryId   Int?      @map("category_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  category          EmployeeCategory?   @relation(fields: [categoryId], references: [id])
  transactions      Transaction[]
  drinkLogs         DrinkLog[]
  donutLogs         DonutLog[]
  employeeHours     EmployeeHour[]
  cleaningLogs      CleaningLog[]
  maintenanceLogs   MaintenanceLog[]    @relation("MaintenanceCreator")
  maintenanceResolver MaintenanceLog[]  @relation("MaintenanceResolver")
  inventoryOrders   InventoryOrder[]
  sopsCreated       Sop[]              @relation("SopCreator")
  sopsUpdated       Sop[]              @relation("SopUpdater")
  dashboardLayout   DashboardLayout?
  espressoDials     EspressoDialLog[]
  inventoryCounts   InventoryCount[]
  orderRequests     OrderRequest[]     @relation("OrderRequester")
  orderReviews      OrderRequest[]     @relation("OrderRequestReviewer")
  batchCompletions  BatchCompletion[]
  sentNotifications Notification[]     @relation("NotificationSender")
  notificationReads NotificationRead[]
  notificationRecipients NotificationRecipient[]
  shifts              Shift[]
  availabilityBlocks  AvailabilityBlock[]
  timeOffRequests     TimeOffRequest[]
  timeOffReviewed     TimeOffRequest[]    @relation("TimeOffReviewer")
  templateShifts      TemplateShift[]
  roastLogs           RoastLog[]         @relation("RoastPerformer")
  menuTaskAssignments MenuTask[]         @relation("MenuTaskAssignee")
  socialPostsCreated  SocialPost[]       @relation("SocialPostCreator")
  socialPostsApproved SocialPost[]       @relation("SocialPostApprover")
  tenantMemberships   TenantUser[]
  tenantInvites       TenantUser[]       @relation("TenantInviter")

  @@map("users")
}

// ─── Products ────────────────────────────────────────────────

model ProductCategory {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int              @id @default(autoincrement())
  name      String
  type      ProductType
  fohBoh    FohBoh           @default(BOTH) @map("foh_boh")
  products  Product[]

  @@map("product_categories")
}

enum ProductType {
  DONUT
  DRINK
  DOGEL
  SANDWICH
  OTHER
}

enum FohBoh {
  FOH
  BOH
  BOTH
}

model Product {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int              @id @default(autoincrement())
  name        String
  categoryId  Int              @map("category_id")
  description String?
  price       Float            @default(0)
  cost        Float            @default(0)
  active      Boolean          @default(true)
  category    ProductCategory  @relation(fields: [categoryId], references: [id])

  ingredients     ProductIngredient[]
  transactionLines TransactionLine[]
  donutLogs       DonutLog[]
  parSheetLines   ParSheetLine[]
  overboardLines  OverboardLine[]

  @@map("products")
}

model ProductIngredient {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id              Int           @id @default(autoincrement())
  productId       Int           @map("product_id")
  inventoryItemId Int           @map("inventory_item_id")
  quantityUsed    Float         @default(0) @map("quantity_used")

  product       Product       @relation(fields: [productId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("product_ingredients")
}

// ─── Sales & Logging ────────────────────────────────────────

model Transaction {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  totalAmount   Float            @map("total_amount") @default(0)
  paymentMethod PaymentMethod?   @map("payment_method")
  notes         String?
  createdAt     DateTime         @default(now()) @map("created_at")

  user  User              @relation(fields: [userId], references: [id])
  lines TransactionLine[]

  @@map("transactions")
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model TransactionLine {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id            Int        @id @default(autoincrement())
  transactionId Int        @map("transaction_id")
  productId     Int?       @map("product_id")
  productName   String     @map("product_name")
  quantity      Int        @default(1)
  unitPrice     Float      @map("unit_price") @default(0)
  total         Float      @default(0)

  transaction Transaction @relation(fields: [transactionId], references: [id])
  product     Product?    @relation(fields: [productId], references: [id])

  @@map("transaction_lines")
}

model DrinkLog {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id             Int        @id @default(autoincrement())
  userId         Int        @map("user_id")
  drinkType      String     @map("drink_type")
  size           String?
  milkType       String?    @map("milk_type")
  espressoShots  Int        @default(0) @map("espresso_shots")
  dialSetting    String?    @map("dial_setting")
  waste          Int        @default(0)
  notes          String?
  createdAt      DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("drink_logs")
}

model DonutLog {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int?     @map("product_id")
  made      Int      @default(0)
  sold      Int      @default(0)
  wasted    Int      @default(0)
  period    ShiftPeriod @default(AM)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@map("donut_logs")
}

enum ShiftPeriod {
  AM
  PM
}

// ─── Vendors ─────────────────────────────────────────────────

model Vendor {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id             Int      @id @default(autoincrement())
  name           String   @unique
  role           String?  // e.g. "Primary broadline vendor"
  mainUse        String?  // e.g. "Donut ingredients, dairy, supplies"
  cadence        String?  // e.g. "Weekly / near-weekly"
  contactInfo    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  inventoryItems InventoryItem[]

  @@map("vendors")
}

// ─── Inventory ──────────────────────────────────────────────

model InventoryItem {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id               Int       @id @default(autoincrement())
  name             String
  category         FohBoh
  unit             String
  unitCost         Float     @map("unit_cost") @default(0)
  parLevel         Float     @map("par_level") @default(0)
  currentStock     Float     @default(0) @map("current_stock")
  minStock         Float     @map("min_stock") @default(0)
  reorderQty       Float     @map("reorder_qty") @default(0)
  supplier         String?   // legacy field, kept for backward compat
  active           Boolean   @default(true)
  vendorId         Int?      @map("vendor_id")
  packSize         String?   @map("pack_size")      // e.g. "50 lb case", "12 x 32 oz case"
  suggestedCadence String?   @map("suggested_cadence") // e.g. "2-3 cases/week"
  sku              String?
  notes            String?
  inventorySection   String     @default("kitchen_regular") @map("inventory_section")
  inventorySectionId Int?       @map("inventory_section_id")

  vendor            Vendor?               @relation(fields: [vendorId], references: [id])
  section           InventorySection?     @relation(fields: [inventorySectionId], references: [id])
  productIngredients ProductIngredient[]
  orderLines        InventoryOrderLine[]
  countLines        InventoryCountLine[]
  orderRequests     OrderRequest[]

  @@map("inventory_items")
}

model InventoryOrder {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int              @id @default(autoincrement())
  status     OrderStatus      @default(DRAFT)
  createdBy  Int              @map("created_by")
  createdAt  DateTime         @default(now()) @map("created_at")
  receivedAt DateTime?        @map("received_at")
  notes      String?

  creator User                @relation(fields: [createdBy], references: [id])
  lines   InventoryOrderLine[]

  @@map("inventory_orders")
}

enum OrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  PARTIAL
}

model InventoryOrderLine {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id              Int           @id @default(autoincrement())
  orderId         Int           @map("order_id")
  inventoryItemId Int           @map("inventory_item_id")
  qtyOrdered      Float         @map("qty_ordered") @default(0)
  qtyReceived     Float         @map("qty_received") @default(0)
  unitCost        Float         @map("unit_cost") @default(0)

  order         InventoryOrder @relation(fields: [orderId], references: [id])
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@map("inventory_order_lines")
}

// ─── Weekly Inventory Counts ─────────────────────────────────

model InventoryCount {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int                  @id @default(autoincrement())
  date       DateTime
  countedBy  Int                  @map("counted_by")
  notes      String?
  createdAt  DateTime             @default(now()) @map("created_at")

  counter User                 @relation(fields: [countedBy], references: [id])
  lines   InventoryCountLine[]

  @@unique([date])
  @@map("inventory_counts")
}

model InventoryCountLine {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id              Int           @id @default(autoincrement())
  countId         Int           @map("count_id")
  inventoryItemId Int           @map("inventory_item_id")
  onHand          Float         @map("on_hand") @default(0)
  amountToOrder   Float         @map("amount_to_order") @default(0)

  count         InventoryCount @relation(fields: [countId], references: [id])
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@unique([countId, inventoryItemId])
  @@map("inventory_count_lines")
}

// ─── Order Requests ──────────────────────────────────────────

// ─── Inventory Sections (DB-driven, replaces enum) ──────────────

model InventorySection {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int              @id @default(autoincrement())
  name      String           // Display name: "Kitchen — Regular Orders"
  slug      String           @unique  // Internal key: "kitchen_regular"
  icon      String           @default("📦")  // Emoji icon
  sortOrder Int              @default(0) @map("sort_order")
  active    Boolean          @default(true)
  items     InventoryItem[]

  @@map("inventory_sections")
}

enum OrderRequestStatus {
  PENDING
  APPROVED
  ORDERED
  FULFILLED
  CANCELLED
}

model OrderRequest {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id             Int               @id @default(autoincrement())
  inventoryItemId Int?             @map("inventory_item_id")
  qtyRequested   Float             @map("qty_requested") @default(0)
  requestedBy    Int               @map("requested_by")
  notes          String?
  status         OrderRequestStatus @default(PENDING)
  reviewedBy     Int?              @map("reviewed_by")
  reviewedAt     DateTime?         @map("reviewed_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Custom item fields (used when inventoryItemId is null — item not in system yet)
  customItemName   String?         @map("custom_item_name")
  customVendorName String?         @map("custom_vendor_name")
  customUnit       String?         @map("custom_unit")

  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  requester     User          @relation("OrderRequester", fields: [requestedBy], references: [id])
  reviewer      User?         @relation("OrderRequestReviewer", fields: [reviewedBy], references: [id])

  @@map("order_requests")
}

// ─── Prediction & Par ───────────────────────────────────────

model HolidaySchedule {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id           Int          @id @default(autoincrement())
  date         DateTime
  name         String
  impactLevel  ImpactLevel  @map("impact_level") @default(MEDIUM)
  notes        String?

  @@map("holiday_schedules")
}

enum ImpactLevel {
  LOW
  MEDIUM
  HIGH
}

model WeatherCache {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id           Int      @id @default(autoincrement())
  date         DateTime @unique
  tempHigh     Float     @map("temp_high") @default(0)
  tempLow      Float     @map("temp_low") @default(0)
  precipitation Float    @default(0)
  conditions   String?
  fetchedAt    DateTime  @map("fetched_at") @default(now())

  @@map("weather_cache")
}

model ParSheet {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int      @id @default(autoincrement())
  date        DateTime @unique
  generatedBy Int?     @map("generated_by")
  notes       String?
  lines       ParSheetLine[]

  @@map("par_sheets")
}

model ParSheetLine {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int      @id @default(autoincrement())
  parSheetId Int      @map("par_sheet_id")
  productId  Int      @map("product_id")
  parLevel   Int      @map("par_level") @default(0)
  onHand     Int      @map("on_hand") @default(0)
  toMake     Int      @map("to_make") @default(0)
  actualSold Int?     @map("actual_sold")
  predicted  Int      @default(0)

  parSheet ParSheet @relation(fields: [parSheetId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("par_sheet_lines")
}

model PredictionModel {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id            Int    @id @default(autoincrement())
  productId     Int    @map("product_id")
  dayOfWeek     Int    @map("day_of_week")
  avgSold       Float  @map("avg_sold") @default(0)
  weatherFactor Float  @map("weather_factor") @default(1.0)
  holidayFactor Float  @map("holiday_factor") @default(1.0)

  @@map("prediction_models")
}

// ─── Operations ─────────────────────────────────────────────

model OverboardSchedule {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id     Int              @id @default(autoincrement())
  date   DateTime
  status OverboardStatus  @default(SCHEDULED)
  name   String?
  notes  String?
  lines  OverboardLine[]
  tasks  MenuTask[]

  @@map("overboard_schedules")
}

enum OverboardStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
}

model OverboardLine {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id             Int     @id @default(autoincrement())
  overboardId    Int     @map("overboard_id")
  productId      Int     @map("product_id")
  quantity       Int     @default(0)
  quantitySold   Int     @default(0) @map("quantity_sold")
  unitPrice      Float   @map("unit_price") @default(0)
  upchargePrice  Float   @map("upcharge_price") @default(0)
  upchargesSold  Int     @default(0) @map("upcharges_sold")
  fillings       String?
  toppings       String?

  overboard OverboardSchedule @relation(fields: [overboardId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])

  @@map("overboard_lines")
}

model CleaningTask {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  frequency   TaskFrequency
  assignedTo  Int?          @map("assigned_to")
  location    String?
  active      Boolean       @default(true)
  logs        CleaningLog[]

  @@map("cleaning_tasks")
}

enum TaskFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model CleaningLog {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int       @id @default(autoincrement())
  taskId      Int       @map("task_id")
  completedBy Int       @map("completed_by")
  completedAt DateTime  @map("completed_at") @default(now())
  notes       String?

  task CleaningTask @relation(fields: [taskId], references: [id])
  user User         @relation(fields: [completedBy], references: [id])

  @@map("cleaning_logs")
}

model MaintenanceLog {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int      @id @default(autoincrement())
  equipment  String
  issue      String
  resolved   Boolean  @default(false)
  resolvedBy Int?     @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdBy  Int      @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  notes      String?

  creator  User  @relation("MaintenanceCreator", fields: [createdBy], references: [id])
  resolver User? @relation("MaintenanceResolver", fields: [resolvedBy], references: [id])

  @@map("maintenance_logs")
}

model EmployeeHour {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  clockIn   DateTime  @map("clock_in")
  clockOut  DateTime?  @map("clock_out")
  totalHours Float?    @map("total_hours")
  date      DateTime
  notes     String?

  user User @relation(fields: [userId], references: [id])

  @@map("employee_hours")
}

// ─── SOPs ───────────────────────────────────────────────────

enum SopCategory {
  FOH
  BOH
  SAFETY
  CLEANING
  OPENING
  CLOSING
  GENERAL
}

model Sop {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int         @id @default(autoincrement())
  title       String
  category    SopCategory
  content     String      @db.MediumText
  fileUrl     String?     @map("file_url")
  version     Int         @default(1)
  active      Boolean     @default(true)
  createdBy   Int         @map("created_by")
  updatedBy   Int?        @map("updated_by")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  creator User @relation("SopCreator", fields: [createdBy], references: [id])
  updater User? @relation("SopUpdater", fields: [updatedBy], references: [id])

  @@map("sops")
}
model DashboardLayout {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id       Int    @id @default(autoincrement())
  userId   Int    @unique @map("user_id")
  layout   String @db.MediumText
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("dashboard_layouts")
}

model EspressoDialLog {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  date              DateTime @default(now())

  // Regular (Meridian Blend)
  groundsWeight     Float?   @map("grounds_weight")
  grinderCoarseness String?  @map("grinder_coarseness")
  dispenseTime      Float?   @map("dispense_time")
  pullTime          Float?   @map("pull_time")
  shotWeight        Float?   @map("shot_weight")

  // Decaf
  decafGroundsWeight     Float?   @map("decaf_grounds_weight")
  decafGrinderCoarseness String?  @map("decaf_grinder_coarseness")
  decafDispenseTime      Float?   @map("decaf_dispense_time")
  decafPullTime          Float?   @map("decaf_pull_time")
  decafShotWeight        Float?   @map("decaf_shot_weight")

  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("espresso_dial_logs")
}

// ─── Recipes ────────────────────────────────────────────────────

model RecipeCategory {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  icon      String   @default("📋")
  color     String   @default("#F9FAFB")   // Background color
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  recipes   Recipe[]

  @@map("recipe_categories")
}

model Recipe {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("general")
  categoryId  Int?     @map("category_id")
  description String?
  ingredients Json     // Array of { name, amount, unit }
  instructions String?
  yield       String?  // e.g. "Makes 1 quart"
  sortOrder   Int      @default(0) @map("sort_order")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  recipeCategory RecipeCategory? @relation(fields: [categoryId], references: [id])

  @@map("recipes")
}

model ProductionTargetOverride {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  target    Int
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("production_target_overrides")
}

model BatchCompletion {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int      @id @default(autoincrement())
  date       DateTime
  batchIndex Int      @map("batch_index")
  mixerType  String   @map("mixer_type")  // "Large" or "Small"
  completedBy Int?    @map("completed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [completedBy], references: [id])

  @@unique([date, batchIndex])
  @@map("batch_completions")
}

model TrayOverride {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int      @id @default(autoincrement())
  date       DateTime
  flavor    String    // Flavor name: "M&M", "Vanilla", etc.
  trays     Float     @default(0)
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([date, flavor])
  @@map("tray_overrides")
}

model PrepItem {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id             Int      @id @default(autoincrement())
  name           String
  category       String
  categoryColor  String   @default("#F3F4F6") @map("category_color")
  amount         String
  shelfLifeHours Int      @default(0) @map("shelf_life_hours")
  sortOrder      Int      @default(0) @map("sort_order")
  active         Boolean  @default(true)

  @@map("prep_items")
}

// ─── Notifications ────────────────────────────────────────────

model Notification {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int      @id @default(autoincrement())
  title      String
  message    String
  priority   String   @default("normal")  // "low", "normal", "high", "urgent"
  sentBy     Int      @map("sent_by")
  createdAt  DateTime @default(now()) @map("created_at")

  sender     User              @relation("NotificationSender", fields: [sentBy], references: [id])
  reads      NotificationRead[]
  recipients NotificationRecipient[]

  @@map("notifications")
}

model NotificationRead {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id             Int      @id @default(autoincrement())
  notificationId Int      @map("notification_id")
  userId         Int      @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  notification Notification @relation(fields: [notificationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

model NotificationRecipient {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id             Int      @id @default(autoincrement())
  notificationId Int      @map("notification_id")
  userId         Int      @map("user_id")

  notification Notification @relation(fields: [notificationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@map("notification_recipients")
}

// ─── Employee Scheduling ────────────────────────────────────────

model Shift {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  date      DateTime
  startTime String   @map("start_time")   // "06:00"
  endTime   String   @map("end_time")     // "14:00"
  position  String   @default("GENERAL")  // GENERAL, FOH, BOH, CLOSING, OPENING
  notes     String?
  published Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  @@map("shifts")
}

model AvailabilityBlock {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  dayOfWeek Int      @map("day_of_week")   // 0=Sun, 1=Mon, ... 6=Sat. -1 = all days
  startTime String?  @map("start_time")    // null = all day blocked
  endTime   String?  @map("end_time")      // null = all day blocked
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  @@map("availability_blocks")
}

model TimeOffRequest {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String?
  status    String   @default("PENDING")  // PENDING, APPROVED, DENIED
  reviewedBy Int?    @map("reviewed_by")
  reviewedAt DateTime? @map("reviewed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])
  reviewer User? @relation("TimeOffReviewer", fields: [reviewedBy], references: [id])

  @@map("time_off_requests")
}

model ScheduleTemplate {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id        Int      @id @default(autoincrement())
  name      String   @default("Default Schedule")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shifts TemplateShift[]

  @@map("schedule_templates")
}

model TemplateShift {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id         Int    @id @default(autoincrement())
  dayOfWeek  Int    @map("day_of_week")    // 0=Sun, 1=Mon...6=Sat
  startTime  String @map("start_time")
  endTime    String @map("end_time")
  position   String @default("GENERAL")
  userId     Int    @map("user_id")

  user     User             @relation(fields: [userId], references: [id])
  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int            @map("template_id")

  @@map("template_shifts")
}

// ─── Module Configuration ────────────────────────────────────

model ModuleConfig {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int     @id @default(autoincrement())
  moduleKey   String  @unique @map("module_key")   // e.g. "roasting", "schedule", "inventory"
  name        String  // Display name, e.g. "Coffee Roasting"
  description String? // Short help text
  enabled     Boolean @default(false)
  icon        String  @default("")                  // Emoji or lucide icon name
  sortOrder   Int     @default(0) @map("sort_order")
  group       String  @default("operations")       // "operations" | "management" | "coffee"

  @@map("module_configs")
}

// ─── Coffee Roasting ─────────────────────────────────────────

model GreenCoffee {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id            Int     @id @default(autoincrement())
  name          String
  origin        String?   // Country / region
  farm          String?
  process       String?   // Washed, Natural, Honey, etc.
  variety       String?   // Typica, Bourbon, Gesha, etc.
  elevation     String?
  grade         String?
  density       String?
  moisture      Float?    // Percentage
  bagWeightKg   Float     @default(60) @map("bag_weight_kg")
  stockKg       Float     @default(0) @map("stock_kg")      // Current on-hand
  costPerKg     Float?    @map("cost_per_kg")
  notes         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  roastLogs    RoastLog[]
  roastProfiles RoastProfile[]

  @@map("green_coffees")
}

model RoastProfile {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id              Int     @id @default(autoincrement())
  name            String
  greenCoffeeId   Int     @map("green_coffee_id")
  targetWeightKg  Float   @map("target_weight_kg")     // Batch size
  chargeTemp      Float?  @map("charge_temp")          // Starting drum temp (°F or °C)
  turnAroundPoint Float?  @map("turn_around_point")    // When beans hit target temp
  firstCrack      Float?  @map("first_crack")          // Time mark (seconds or string)
  developmentTime Float?  @map("development_time")     // Post-first-crack seconds
  dropTemp        Float?  @map("drop_temp")            // Final bean temp
  totalDuration   Float?  @map("total_duration")       // Total roast seconds
  roastLevel      String  @default("MEDIUM") @map("roast_level")  // LIGHT / MEDIUM / MEDIUM_DARK / DARK
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  greenCoffee GreenCoffee @relation(fields: [greenCoffeeId], references: [id])
  roastLogs   RoastLog[]

  @@map("roast_profiles")
}

model RoastLog {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id              Int     @id @default(autoincrement())
  date            DateTime
  greenCoffeeId   Int     @map("green_coffee_id")
  profileId       Int?    @map("profile_id")
  greenWeightKg   Float   @map("green_weight_kg")      // Input weight
  roastedWeightKg Float   @map("roasted_weight_kg")    // Output weight
  roastLevel      String  @default("MEDIUM") @map("roast_level")
  chargeTemp      Float?  @map("charge_temp")
  firstCrackTime  Float?  @map("first_crack_time")
  dropTemp        Float?  @map("drop_temp")
  totalDuration   Float?  @map("total_duration")       // Seconds
  notes           String?
  lossPercent     Float?  @map("loss_percent")         // Auto-calculated
  batchNumber     String? @map("batch_number")
  performedBy     Int?    @map("performed_by")
  createdAt       DateTime @default(now()) @map("created_at")

  greenCoffee  GreenCoffee   @relation(fields: [greenCoffeeId], references: [id])
  profile      RoastProfile? @relation(fields: [profileId], references: [id])
  performer    User?         @relation("RoastPerformer", fields: [performedBy], references: [id])

  @@map("roast_logs")
}

// ─── Menu Planning Tasks ────────────────────────────────────

model MenuTask {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id          Int      @id @default(autoincrement())
  scheduleId Int      @map("schedule_id")     // Links to OverboardSchedule (menu plan)
  title      String
  completed  Boolean  @default(false)
  dueDate    DateTime? @map("due_date")
  assignedTo Int?     @map("assigned_to")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  schedule  OverboardSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignee  User?             @relation("MenuTaskAssignee", fields: [assignedTo], references: [id])

  @@map("menu_tasks")
}

// ─── Social Media Planner ──────────────────────────────────

model SocialPost {
  tenantId Int @default(1) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  id            Int      @id @default(autoincrement())
  title         String
  description   String?                    // Caption / copy
  platform      String   @default("ALL")   // ALL, INSTAGRAM, FACEBOOK, TIKTOK, TWITTER
  postDate      DateTime? @map("post_date") // Scheduled date
  status        String   @default("DRAFT")  // DRAFT, SCHEDULED, PUBLISHED, CANCELLED
  mediaUrl      String?  @map("media_url")  // Image/video link or uploaded path
  linkUrl       String?  @map("link_url")   // Link to share
  notes         String?
  approvedBy    Int?     @map("approved_by")
  createdById   Int      @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  approvedByUser User?  @relation("SocialPostApprover", fields: [approvedBy], references: [id])
  createdByUser  User  @relation("SocialPostCreator", fields: [createdById], references: [id])

  @@map("social_posts")
}
