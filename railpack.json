{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["npm ci"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npx prisma generate", "npm run build"]
    }
  },
  "deploy": {
    "startCommand": "npx prisma db push --accept-data-loss && npx next start"
  }
}